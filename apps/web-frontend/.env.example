# ==============================================================================
# PRODUCT TRACE FRONTEND - ENVIRONMENT CONFIGURATION (VITE)
# Hướng dẫn: Copy file này thành ".env" cùng thư mục để sử dụng.
# ==============================================================================

# ------------------------------------------------------------------------------
# CÁCH 1: KẾT NỐI TRỰC TIẾP QUA PORT CONTAINER (Thường dùng cho Dev Local)
# ------------------------------------------------------------------------------

# URL API của Go Core Service (lắng nghe ở cổng 8080, route root là /api)
VITE_GO_CORE_API_URL=http://localhost:8080/api

# URL API của Nest AI Service (lắng nghe ở cổng 3000, không có route root)
VITE_NEST_AI_API_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# CÁCH 2: KẾT NỐI THÔNG QUA API GATEWAY KONG (Lắng nghe ở cổng 8000)
# (Dùng khi deploy đồng bộ, clean routing qua một cổng duy nhất)
# ------------------------------------------------------------------------------
# VITE_GO_CORE_API_URL=http://localhost:8000/api
# VITE_NEST_AI_API_URL=http://localhost:8000/ai
