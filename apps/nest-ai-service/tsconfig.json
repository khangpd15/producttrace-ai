
{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "sourceMap": true,
    "removeComments": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "allowSyntheticDefaultImports": true,
    "incremental": false,

    "strict": true,
    "skipLibCheck": true,

    "types": ["node"]
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}