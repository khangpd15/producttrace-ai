BASE_URL=http://localhost:8080/

# PostgreSQL
POSTGRES_DB=product_trace_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433
# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/

# RabbitMQ URL
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672/

# Event
RABBITMQ_EXCHANGE=product-trace.events

# Go Service
GO_CORE_PORT=8080

# Nest Service
NEST_PORT=3000
GO_CORE_URL=http://go-core-service:8080